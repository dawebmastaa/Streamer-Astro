---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";
const { title, description, robots } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
    title={title}
    description={description}
    robots={robots}
    />
    <script type="text/javascript">window.$crisp=[];window.CRISP_WEBSITE_ID="2ce0f4e3-1591-4acb-b57b-baf0b42d1edd";(function(){d=document;s=d.createElement("script");s.src="https://client.crisp.chat/l.js";s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();</script>
  </head>
  <body class="bg-smoke">
    <Navigation />
    <slot />
    <Footer />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </body>
</html>